# Salin ke .env lalu sesuaikan. Semua opsional.

# Port web di host (tanpa profil tls)
WEB_PORT=8080

# Domain untuk profil tls (docker compose --profile tls up -d)
DOMAIN=glowmatch.example.com

# Thread PyTorch (0 = otomatis). Set ke jumlah core CPU server.
TORCH_THREADS=0
# 0 = semua fold (sesuai training). 1-2 = lebih cepat, sedikit menyimpang dari hasil notebook.
MAX_FOLDS=0
# Gray-World white balance (1/0) dan kekuatannya (0..1)
WHITE_BALANCE=1
WB_STRENGTH=1.0
MAX_UPLOAD_MB=8
# Batas RAM container API (model penuh butuh ~2-3 GB)
API_MEMORY=4g
