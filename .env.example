# Salin ke .env lalu sesuaikan. JANGAN commit file .env ke git.

# Port web di host (tanpa profil tls)
WEB_PORT=8080

# Domain untuk profil tls (docker compose --profile tls up -d)
DOMAIN=glowmatch.example.com

# Thread PyTorch (0 = otomatis). Set ke jumlah core CPU server.
TORCH_THREADS=0
# 0 = semua fold (sesuai training). 1-2 = lebih cepat, sedikit menyimpang dari hasil notebook.
MAX_FOLDS=0
# Gray-World white balance (1/0) dan kekuatannya (0..1)
WHITE_BALANCE=1
WB_STRENGTH=1.0
MAX_UPLOAD_MB=8
# Batas RAM container API (model penuh butuh ~2-3 GB)
API_MEMORY=4g

# Database PostgreSQL (WAJIB diisi untuk aplikasi & migrasi; tanpa spasi di sekitar '=')
# Untuk Neon PostgreSQL:
GLOWMATCH_DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB_NAME?sslmode=require
GLOWMATCH_MIGRATION_DATABASE_URL=postgresql://OWNER_USER:OWNER_PASSWORD@HOST/DB_NAME?sslmode=require

# Untuk PostgreSQL lokal via Docker (--profile local-db), gunakan host "db":
# POSTGRES_USER=glowmatch
# POSTGRES_PASSWORD=ganti_password_kuat
# POSTGRES_DB=glowmatch
# POSTGRES_PORT=127.0.0.1:5432
# GLOWMATCH_DATABASE_URL=postgresql://glowmatch:ganti_password_kuat@db:5432/glowmatch
# GLOWMATCH_MIGRATION_DATABASE_URL=postgresql://glowmatch:ganti_password_kuat@db:5432/glowmatch

# CORS origins (dipisah koma, opsional)
# GLOWMATCH_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080

# ------------------------------------------------------------
# Chat AI rekomendasi outfit (9router, endpoint OpenAI-compatible)
# ------------------------------------------------------------
# Dipakai saat backend jalan lokal (uvicorn). Docker memakai DOCKER_AI_BASE_URL.
GLOWMATCH_AI_BASE_URL=http://localhost:20128/v1
# Alamat 9router dari dalam container (default sudah benar bila 9router jalan di host)
# DOCKER_AI_BASE_URL=http://host.docker.internal:20128/v1
# API key dari dashboard 9router. RAHASIA: hanya di .env, jangan di-commit / jangan di frontend.
GLOWMATCH_AI_API_KEY=
# Nama model/combo persis seperti di dashboard 9router
GLOWMATCH_AI_MODEL=
# Batas token jawaban. Model lewat 9router (cc/, ag/) ikut memakai token untuk berpikir;
# di bawah ~1000 jawaban bisa kosong/terpotong. Panjang jawaban tetap dibatasi prompt (maks 80 kata).
GLOWMATCH_AI_MAX_TOKENS=1500
# Jumlah pesan per sesi tiap 10 menit
GLOWMATCH_AI_RATE_LIMIT=20
# Foto outfit: template URL generator gambar ({prompt}, {seed}). Kosongkan untuk hanya ilustrasi warna.
# GLOWMATCH_OUTFIT_IMAGE_URL=https://image.pollinations.ai/prompt/{prompt}?width=512&height=640&nologo=true&seed={seed}
